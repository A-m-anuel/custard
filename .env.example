# Copy to .env for local development. Real environment variables take precedence.
CUSTARD_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
CUSTARD_SECRET_KEY=
CUSTARD_ALLOWED_HOSTS=localhost,127.0.0.1
# CUSTARD_CSRF_TRUSTED_ORIGINS=https://custard.example.com
# DATABASE_URL=postgres://custard:password@localhost:5432/custard
DATABASE_URL=sqlite:///db.sqlite3
CUSTARD_ORGANISATION_NAME=Example Ltd
CUSTARD_EXPOSURE_THRESHOLD=5.0
CUSTARD_TIME_ZONE=Europe/London
# Behind a TLS-terminating reverse proxy:
# CUSTARD_BEHIND_TLS_PROXY=true
# CUSTARD_TRUST_X_FORWARDED_FOR=true
# CUSTARD_ADMIN_URL=manage-7f3a/
